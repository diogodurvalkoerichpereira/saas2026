NODE_ENV=development
PORT=3000
# Use DATABASE_URL (uma linha) OU as cinco variáveis abaixo. A URL tem precedência e é a forma
# que Coolify/Railway/Render injetam automaticamente.
# DATABASE_URL=postgres://usuario:senha@host:5432/erp
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=erp
DATABASE_USER=postgres
DATABASE_PASSWORD=
# true quando o Postgres exigir TLS sem cadeia pública (instância gerenciada).
DATABASE_SSL=false
JWT_SECRET=troque-por-uma-chave-longa-e-unica
CORS_ORIGIN=http://localhost:3000
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_INSTANCE_ID=
WHATSAPP_DISPATCH_ENABLED=false
WHATSAPP_BATCH_SIZE=20
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_RETRY_MINUTES=15
JOBS_ENABLED=false
JOBS_INTERVAL_MINUTES=5
