{
  "name": "saas2026-node",
  "version": "0.1.0",
  "private": true,
  "description": "Migração do ERP legado em PHP para Node.js.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "test:integration": "node --test test/integration.db.test.js",
    "test:e2e": "node --test test/e2e.local.test.js",
    "test:browser": "playwright test",
    "docker:test:up": "docker compose -f compose.test.yml up --build -d",
    "docker:test:down": "docker compose -f compose.test.yml down -v",
    "db:reset": "psql -v ON_ERROR_STOP=1 -f db/001-schema.sql && psql -v ON_ERROR_STOP=1 -f db/002-seed-test.sql",
    "test:db": "node --test test/integration.db.test.js test/postgres-regressao.test.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.4.0",
    "pg": "^8.22.0",
    "xml-crypto": "^6.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1"
  }
}
